{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
      "build": {
        "dependsOn": ["^build"],
        "outputs": ["dist/**"]
      },
      "lint": {
        "dependsOn": ["^lint", "//#check:deps"]
      },
      "//#check:deps": {
        "outputs": []
      },
      "test": {
        "dependsOn": ["^build"],
        "outputs": []
      },
      "test:e2e": {
        "dependsOn": ["^build"],
        "cache": false,
        "outputs": []
      }
    }
}